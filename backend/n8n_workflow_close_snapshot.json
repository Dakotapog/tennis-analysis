{
  "name": "Tennis Close-Snapshot Timing",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "Cada 5 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8765/check-and-close",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Check & Close Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "Exito?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "// Rama TRUE: snapshot_ran=true → log informativo\nconst data = $input.first().json;\nif (data.snapshot_ran) {\n  const ts = new Date().toISOString();\n  const ids = (data.processed || []).join(', ');\n  console.log(`[${ts}] close-snapshot OK | partidos: ${ids}`);\n}\nreturn $input.all();"
      },
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "Log OK",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "jsCode": "// Rama FALSE / error: loguear fallo\nconst data = $input.first().json;\nconst ts = new Date().toISOString();\nconst msg = data.error || data.output || JSON.stringify(data);\nconsole.error(`[${ts}] ERROR close-snapshot: ${msg}`);\n// Re-emitir para posible alerta futura (Telegram, etc.)\nreturn [{ json: { ts, error: msg, workflow: 'Tennis Close-Snapshot Timing' } }];"
      },
      "id": "a1b2c3d4-0005-0005-0005-000000000005",
      "name": "Log Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 420]
    }
  ],
  "connections": {
    "Cada 5 minutos": {
      "main": [
        [
          {
            "node": "Check & Close Snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check & Close Snapshot": {
      "main": [
        [
          {
            "node": "Exito?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Exito?": {
      "main": [
        [
          {
            "node": "Log OK",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "tags": ["tennis", "shadow-book", "automation"]
}
