{
  "name": "Tennis Bridge Healthcheck",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "c3d4e5f6-0001-0001-0001-000000000001",
      "name": "Cada 30 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8765/health",
        "options": {
          "timeout": 5000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "c3d4e5f6-0002-0002-0002-000000000002",
      "name": "Ping bridge :8765",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-health-1",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000003",
      "name": "Bridge OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "console.log(`[healthcheck] bridge :8765 OK — ${new Date().toISOString()}`);\nreturn $input.all();"
      },
      "id": "c3d4e5f6-0004-0004-0004-000000000004",
      "name": "Log OK",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "url": "https://api.telegram.org/bot8684706586:AAHv4zhjQKvxORf6bnbwCxZQPly9OA7unpY/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"chat_id\": \"8520949513\",\n  \"text\": \"🔴 TENNIS BRIDGE CAIDO\\n\\nEl bridge :8765 no responde.\\nLos close-snapshots NO se estan ejecutando.\\n\\nFix rapido: systemctl --user restart tennis-snapshot-bridge\",\n  \"parse_mode\": \"HTML\"\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "c3d4e5f6-0005-0005-0005-000000000005",
      "name": "Alerta Telegram bridge caido",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 420]
    }
  ],
  "connections": {
    "Cada 30 minutos": {
      "main": [[{ "node": "Ping bridge :8765", "type": "main", "index": 0 }]]
    },
    "Ping bridge :8765": {
      "main": [
        [{ "node": "Bridge OK?", "type": "main", "index": 0 }],
        [{ "node": "Alerta Telegram bridge caido", "type": "main", "index": 0 }]
      ]
    },
    "Bridge OK?": {
      "main": [
        [{ "node": "Log OK", "type": "main", "index": 0 }],
        [{ "node": "Alerta Telegram bridge caido", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "tags": ["tennis", "automation", "alertas", "healthcheck"]
}
